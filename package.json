{
  "name": "content-approval-webflow",
  "version": "1.0.0",
  "description": "Webflow App adding a multi-stage editorial approval workflow with roles, comments, and publish gating for CMS items.",
  "private": true,
  "main": "server/index.ts",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "ts-node server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "build:extension": "node designer-extension/esbuild.config.mjs",
    "typecheck:extension": "tsc -p designer-extension/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^11.1.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "esbuild": "^0.23.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/better-sqlite3": "^7.6.11"
  }
}
