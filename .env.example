WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback
WEBFLOW_SCOPES=cms:read,cms:write,sites:read,authorized_user:read

# Public https base URL Webflow can reach for webhooks (use your ngrok https URL during local dev).
APP_PUBLIC_URL=http://localhost:3000

# Passphrase used to derive the AES-256-GCM key that encrypts stored OAuth tokens
TOKEN_ENCRYPTION_KEY=change-me-in-production

# Background job interval (minutes): sends due/overdue review reminders through services/mailer.ts
REMINDER_INTERVAL_MIN=15
# Default hours before a review request's due date at which reminders start
DEFAULT_REMINDER_LEAD_HOURS=24

DATABASE_PATH=./db/approvals.sqlite
PORT=3000
